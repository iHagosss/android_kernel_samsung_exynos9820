# ExtremeKernel config file for enabling KSU

# Enable KSU
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
CONFIG_KSU_ALLOWLIST_WORKAROUND=y
# CONFIG_KSU_SUSFS is not set

# Enable Maxim MAX77705 PMIC/charger/fuel-gauge support to improve
# charging negotiation (AFC/QC/PD) and orientation handling for
# beyond* Exynos devices (beyond2lte).
# These options will build the MAX77705 MFD, charger and fuelgauge
# as modules so the drivers can be loaded at runtime.
CONFIG_MFD_MAX77705=m
CONFIG_CHARGER_MAX77705=m
CONFIG_FUELGAUGE_MAX77705=m
CONFIG_CCIC_MAX77705=m
CONFIG_MUIC_MAX77705=m
CONFIG_MAX77705_FW_PID03_SUPPORT=y
CONFIG_HV_MUIC_MAX77705_AFC=y

# EOF
